# PUBLIC INTERFACE: Environment variables required by the frontend app.
# Copy this file to .env and adjust as needed. Do not commit the .env file.

# PUBLIC_INTERFACE
# App title shown in the header
REACT_APP_APP_TITLE=Personal Notes

# PUBLIC_INTERFACE
# Future backend API base URL (not used for localStorage mode). Keep for later integration.
REACT_APP_API_BASE_URL=https://example.com/api
